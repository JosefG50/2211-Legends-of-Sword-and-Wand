FROM python:3.12-slim

WORKDIR /app

# Install system dependencies for C-extensions (like psycopg2 for Postgres)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy everything from the Pvp folder into /app
COPY . .

# Ensure the main.py is executable and visible
RUN ls -la /app

EXPOSE 8000

# Using uvicorn is better for FastAPI, assuming your FastAPI instance in main.py is 'app'
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]